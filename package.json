{
  "name": "sound-editor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Browser-based audio editor (React + Web Audio API). Source lives in app/, `npm run build` writes the GitHub Pages site (index.html + assets/) to the repo root.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "test:build": "vite build && playwright test",
    "format": "prettier --write app/src tests",
    "format:check": "prettier --check app/src tests"
  },
  "dependencies": {
    "mpg123-decoder": "1.0.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.8.1",
    "vite": "8.3.3"
  }
}
